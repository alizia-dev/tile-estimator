{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "Jwt": {
    "Issuer": "TileEstimator",
    "Audience": "TileEstimatorWeb",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "Database": {
    "AutoMigrate": false,
    "SeedDemoData": false,
    "CommandTimeoutSeconds": 30
  },
  "Storage": {
    "RootPath": "storage",
    "MaxUploadMegabytes": 25
  },
  "Email": {
    "FromAddress": "no-reply@tileestimator.local",
    "FromName": "Tile Estimator",
    "OutboxPath": "outbox"
  },
  "Application": {
    "WebAppBaseUrl": "http://localhost:4200",
    "CorsOrigins": [ "http://localhost:4200" ],
    "EmailVerificationHours": 48,
    "PasswordResetHours": 2,
    "InvitationDays": 14,
    "QuoteLinkGraceDays": 7,
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15
  },
  "AllowedHosts": "*"
}
